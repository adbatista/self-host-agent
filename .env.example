# Copy to .env and fill in. `.env` is gitignored - never commit the token.

# <org>.semaphoreci.com
SEMAPHORE_AGENT_ENDPOINT=adias.semaphoreci.com

# Registration token shown once when creating the agent type in Semaphore.
SEMAPHORE_AGENT_TOKEN=replace-me

# Optional (defaults shown). See https://docs.semaphore.io/reference/self-hosted-config
# SEMAPHORE_AGENT_NAME=                       # 8-64 chars; random if empty
# SEMAPHORE_AGENT_DISCONNECT_AFTER_JOB=false
# SEMAPHORE_AGENT_DISCONNECT_AFTER_IDLE_TIMEOUT=0
# SEMAPHORE_AGENT_UPLOAD_JOB_LOGS=never       # never | when-trimmed | always
# SEMAPHORE_AGENT_INTERRUPTION_GRACE_PERIOD=0
